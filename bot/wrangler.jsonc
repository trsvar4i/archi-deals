{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "archi-deals-bot",
  "main": "src/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-09-18",
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "BOT_TOKEN",
      "WEBHOOK_SECRET",
      "ADMIN_CHAT_ID"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "archi-deals-bot",
      "database_id": "ba8d424c-3c2a-412e-9aec-c30a4c857d35"
    }
  ]
}
